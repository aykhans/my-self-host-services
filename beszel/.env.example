############# hub #############
# Public URL of the hub; must match BESZEL_DOMAIN in caddy/.env.
APP_URL=https://sub.example.com

############# agent #############
# Both are shown by the hub under "Add System" once it is running. KEY is the
# hub's public key, TOKEN authenticates this host's agent. Fill them in, then
# start the agent.
#
# The agent's remaining settings are not secrets and live in
# docker-compose.yaml instead: LISTEN points at the socket it shares with the
# hub, and no HUB_URL is needed because the hub connects to that socket.
KEY=
TOKEN=
